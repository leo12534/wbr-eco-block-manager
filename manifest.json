{
  "manifest_version": 3,
  "name": "ECO Admin Block Manager",
  "version": "1.6",
  "description": "Add, manage, export and delete page_content blocks in ECO Admin, and download their images",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://ecoadmin.wbresearch.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
